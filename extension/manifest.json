{
  "manifest_version": 3,
  "name": "DywanMag — Asystent Dywanów Leroy Merlin",
  "version": "1.0.0",
  "description": "Błyskawiczne sprawdzanie stojaków dywanowych (1a-23b) oraz przypisywanie dywanów bezpośrednio z kart produktów leroymerlin.pl.",
  "icons": {
    "16": "icon-16.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon-48.png",
    "default_title": "DywanMag - Wyszukaj stojak"
  },
  "permissions": [
    "activeTab",
    "storage"
  ],
  "content_scripts": [
    {
      "matches": ["*://*.leroymerlin.pl/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
