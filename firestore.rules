rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userEmail() {
      return request.auth.token.email.lower();
    }

    function isSuperAdmin() {
      return isSignedIn() && userEmail() == 'abaluch@leroymerlin.pl';
    }

    function isAdmin() {
      return isSuperAdmin() || (
        isSignedIn() && (
          exists(/databases/$(database)/documents/admins/$(userEmail())) ||
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['ADMIN', 'SUPER_ADMIN'])
        )
      );
    }

    function isValidUser(data) {
      return data.keys().hasAll(['userId', 'email', 'role']) &&
             data.userId is string &&
             data.email is string &&
             data.role in ['SUPER_ADMIN', 'ADMIN', 'USER'];
    }

    function isValidAdmin(data) {
      return data.keys().hasAll(['email', 'addedBy']) &&
             data.email is string &&
             data.addedBy is string;
    }

    function isValidPalek(data) {
      return data.keys().hasAll(['id', 'numer', 'slots']) &&
             data.id is string &&
             data.numer is int && data.numer >= 1 &&
             data.slots is map;
    }

    function isValidDywan(data) {
      return data.keys().hasAll(['km', 'palekNumer', 'miejsce', 'slot']) &&
             data.km is string &&
             data.km.matches('^[0-9]{8}$') &&
             data.palekNumer is int && data.palekNumer >= 1 &&
             data.miejsce is string &&
             data.slot in ['A', 'B'];
    }

    function isValidHistory(data) {
      return data.keys().hasAll(['id', 'action', 'userEmail', 'details']) &&
             data.id is string &&
             data.action in ['ADD', 'REMOVE', 'MOVE', 'SWAP', 'CREATE_PALEK', 'DELETE_PALEK', 'UPDATE_PRODUCT'] &&
             data.userEmail is string &&
             data.details is string;
    }

    // Kolekcja profili użytkowników
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && (
        isSuperAdmin() ||
        (request.auth.uid == userId && (
          !('role' in request.resource.data) ||
          request.resource.data.role == 'USER' ||
          (isSuperAdmin() && request.resource.data.role in ['SUPER_ADMIN', 'ADMIN', 'USER'])
        ))
      ) && isValidUser(request.resource.data);
      allow delete: if isSuperAdmin();
    }

    // Kolekcja administratorów - TYLKO SUPER ADMIN (abaluch@leroymerlin.pl) może modyfikować
    match /admins/{adminEmail} {
      allow read: if isSignedIn();
      allow create, update: if isSuperAdmin() && isValidAdmin(request.resource.data);
      allow delete: if isSuperAdmin() && adminEmail != 'abaluch@leroymerlin.pl';
    }

    // Pałąki ekspozycyjne - odczyt dla każdego zalogowanego, modyfikacje dla adminów
    match /palki/{palekId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() && isValidPalek(request.resource.data);
      allow delete: if isAdmin();
    }

    // Dywany (indeks KM) - odczyt dla każdego zalogowanego, modyfikacje dla adminów
    match /dywany/{km} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() && isValidDywan(request.resource.data);
      allow delete: if isAdmin();
    }

    // Historia operacji - niezmienny rejestr audytowy (immutable)
    match /history/{logId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() && isValidHistory(request.resource.data);
      allow update, delete: if false;
    }

    // Historia zmian cen produktów Leroy Merlin
    match /productPriceHistory/{priceHistoryId} {
      allow read: if isSignedIn();
      allow create: if isAdmin();
      allow update, delete: if false;
    }
  }
}
