{
  "entities": {
    "Carpet": {
      "title": "Carpet",
      "description": "A carpet or rug allocated in the store warehouse/exhibition slot",
      "type": "object",
      "properties": {
        "magazyn": {
          "type": "number",
          "description": "Warehouse rack/bay number, e.g. 1, 2, 3..."
        },
        "podmagazyn": {
          "type": "string",
          "description": "Sub-bay identifier, typically 'A' or 'B'",
          "maxLength": 10
        },
        "nazwa": {
          "type": "string",
          "description": "Product display name and dimensions",
          "maxLength": 300
        },
        "ref": {
          "type": "string",
          "description": "Leroy Merlin reference number (ref LM)",
          "maxLength": 50
        },
        "ean": {
          "type": "string",
          "description": "EAN barcode number",
          "maxLength": 50
        },
        "miejsce": {
          "type": "string",
          "description": "Slot location label, e.g. '1 A'",
          "maxLength": 50
        },
        "dodano": {
          "type": "string",
          "description": "Date added or formatted date string",
          "maxLength": 50
        },
        "updatedAt": {
          "type": "string",
          "description": "Last update timestamp"
        },
        "updatedBy": {
          "type": "string",
          "description": "Email or ID of user who modified"
        }
      },
      "required": ["magazyn", "podmagazyn", "miejsce"]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Authorized administrator email for Sklep 038",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "description": "Email address of the authorized admin",
          "maxLength": 150
        },
        "role": {
          "type": "string",
          "description": "Admin role: superadmin or admin",
          "enum": ["superadmin", "admin"]
        },
        "addedBy": {
          "type": "string",
          "description": "Email who granted admin rights",
          "maxLength": 150
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp"
        }
      },
      "required": ["email", "role"]
    },
    "Warehouse": {
      "title": "Warehouse",
      "description": "Store warehouse bay / rack number for Sklep 038",
      "type": "object",
      "properties": {
        "number": {
          "type": "number",
          "description": "Warehouse rack number, e.g. 15, 120"
        },
        "name": {
          "type": "string",
          "description": "Optional custom name or description",
          "maxLength": 100
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp"
        },
        "createdBy": {
          "type": "string",
          "description": "Creator email"
        }
      },
      "required": ["number"]
    },
    "ActivityLog": {
      "title": "ActivityLog",
      "description": "Audit trail log tracking who modified, added or removed carpets, warehouses and admins in Sklep 038",
      "type": "object",
      "properties": {
        "timestamp": {
          "type": "string",
          "description": "ISO timestamp of the modification"
        },
        "userEmail": {
          "type": "string",
          "description": "Email address of the administrator who made the change",
          "maxLength": 150
        },
        "userName": {
          "type": "string",
          "description": "Optional display name",
          "maxLength": 100
        },
        "action": {
          "type": "string",
          "description": "Type of database action",
          "enum": ["add", "edit", "delete", "import", "add_warehouse", "delete_warehouse", "add_admin", "remove_admin"]
        },
        "target": {
          "type": "string",
          "description": "Brief description of the modified target",
          "maxLength": 200
        },
        "details": {
          "type": "string",
          "description": "Human-readable details of the change",
          "maxLength": 1000
        },
        "miejsce": {
          "type": "string",
          "description": "Warehouse rack/slot location",
          "maxLength": 50
        },
        "ref": {
          "type": "string",
          "description": "Product ref number",
          "maxLength": 50
        },
        "ean": {
          "type": "string",
          "description": "Product EAN barcode",
          "maxLength": 50
        }
      },
      "required": ["timestamp", "userEmail", "action", "target", "details"]
    }
  },
  "firestore": {
    "/carpets/{carpetId}": {
      "schema": "Carpet",
      "description": "Carpet products exhibited and stored in Sklep 038"
    },
    "/admins/{adminId}": {
      "schema": "AdminUser",
      "description": "Authorized admin users for managing Sklep 038"
    },
    "/warehouses/{warehouseId}": {
      "schema": "Warehouse",
      "description": "Configured warehouse bays in Sklep 038"
    },
    "/activity_logs/{logId}": {
      "schema": "ActivityLog",
      "description": "Audit trail entries tracking who made database changes in Sklep 038"
    }
  }
}
